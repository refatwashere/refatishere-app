Options -Indexes
<IfModule mod_env.c>
SetEnv API_TOKEN_CRYPTO REPLACE_API_TOKEN_CRYPTO
SetEnv BINANCE_BASE_URL https://api.binance.com
SetEnv DB_HOST REPLACE_DB_HOST
SetEnv DB_PORT REPLACE_DB_PORT
SetEnv DB_NAME REPLACE_DB_NAME
SetEnv DB_USER REPLACE_DB_USER
SetEnv DB_PASS REPLACE_DB_PASS
SetEnv ALLOWED_ORIGINS https://refatishere.free.nf
SetEnv PLANNER_SIDECAR_URL REPLACE_PLANNER_SIDECAR_URL
SetEnv PLANNER_SIDECAR_TOKEN REPLACE_PLANNER_SIDECAR_TOKEN
SetEnv PANCAKESWAP_AI_API_URL REPLACE_PANCAKESWAP_AI_API_URL
SetEnv PANCAKESWAP_AI_API_KEY REPLACE_PANCAKESWAP_AI_API_KEY
SetEnv PANCAKESWAP_AI_TIMEOUT_MS 8000
</IfModule>
